#!/bin/sh
set -e

case "$1" in
    remove|upgrade|deconfigure)
        if systemctl is-active --quiet oufdee 2>/dev/null; then
            systemctl stop oufdee || true
        fi
        if systemctl is-enabled --quiet oufdee 2>/dev/null; then
            systemctl disable oufdee || true
        fi
        ;;
esac

#DEBHELPER#
